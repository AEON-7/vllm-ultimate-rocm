@@ -172,5 +173,23 @@ class Inkling2Gfx12MoE(nn.Module):
     def forward(self, x: torch.Tensor) -> torch.Tensor:
         """bf16 [T, H] -> bf16 [T, H]."""
         x = x.contiguous()
+        ex = self.experts
