diff --git a/vllm/models/inkling2/amd/ops/sconv_mix.py b/vllm/models/inkling2/amd/ops/sconv_mix.py
new file mode 100644
index 000000000..61ce509fb
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/sconv_mix.py
@@ -0,0 +1,197 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 AEON-7
+# Original AEON work (clean room); calls the PR #67685 (Apache-2.0) `_conv`
+# helper unchanged; the mix follows its `_attn_res_row_kernel` math.
+"""Small-batch fusion of a static short conv (with its residual update) and
+the attention-residual mix that consumes its output.
+
+One program per token holds the full channel row: it runs the
+`_sconv_kernel` math for all channels (in the mix's two row chunks), stores
+the conv output and keeps it in registers, then runs the
+`_attn_res_row_kernel` math for every pseudo-query of that token, taking the
+conv output from registers (no cross-warp memory dependency). Bit-equal
+to the two launches it replaces (same helpers, same op order, no fp fusion)
+and saves one launch per call (two per decoder-layer visit).
+"""
+
+import torch
+
+from vllm.triton_utils import tl, tldevice, triton
+
+from .sconv import _conv
+
+MAX_T = 8
+
+
+@triton.jit
+def _conv_chunk(x_ptr, cache_ptr, weight_ptr, out_ptr, res_ptr, addend_ptr, pos_ptr,
+                seq_idx_ptr, slot_ptr, block_table_ptr, qstart_ptr, T, stride_x, stride_c_blk,
+                stride_c_h, stride_c_n, stride_w0, stride_w1, stride_bt, max_blocks, N, scale,
+                t, coff, W: tl.constexpr, OFF: tl.constexpr, WS: tl.constexpr, H: tl.constexpr,
+                HAS_RES: tl.constexpr, HAS_ADDEND: tl.constexpr):
+    """`_sconv_kernel` (BT = 1) for channels `coff` of token t: stores the
+    output and returns it (output dtype, [1, len(coff)])."""
+    toff = t + tl.arange(0, 1)
+    C = H * WS
+    t_mask = toff < T
+    c_mask = coff < C
+    y = _conv(
+        x_ptr, stride_x, cache_ptr,
+        tl.minimum(coff // WS, H - 1) * stride_c_h + OFF + coff % WS,
+        stride_c_blk, stride_c_n, N, weight_ptr, stride_w0, stride_w1,
+        pos_ptr, seq_idx_ptr, slot_ptr, block_table_ptr, stride_bt, max_blocks,
+        qstart_ptr, scale, toff, coff, t_mask, c_mask, W,
+        SKIP_IDLE_CACHE=False, CACHE_FIRST=True, tile_reads_cache=True,
+    ).to(out_ptr.dtype.element_ty)
+    offs = toff[:, None] * C + coff[None, :]
+    mask = t_mask[:, None] & c_mask[None, :]
+    if HAS_ADDEND:
+        acc = tl.load(addend_ptr + offs, mask, other=0).to(tl.float32)
+        if HAS_RES:
+            acc = tl.load(res_ptr + offs, mask, other=0).to(tl.float32) + acc
+        y = (acc + y.to(tl.float32)).to(out_ptr.dtype.element_ty)
+    tl.store(out_ptr + offs, y, mask=mask)
+    return y
+
+
+@triton.jit
+def _src(Stack, stride_s, Last, Addend, row_off, offs, mask, n, N_STACK: tl.constexpr,
+         HAS_ADDEND: tl.constexpr, LAST_IS_OUT: tl.constexpr, ADDEND_IS_OUT: tl.constexpr,
+         y_reg):
+    """`_load_source` with this conv's output taken from registers (`y_reg`)
+    instead of memory where it is the last source or its addend."""
+    if n < N_STACK:
+        x = tl.load(Stack + n * stride_s + row_off + offs, mask, other=0).to(tl.float32)
+    else:
+        if LAST_IS_OUT:
+            x = y_reg
+        else:
+            x = tl.load(Last + row_off + offs, mask, other=0).to(tl.float32)
+        if HAS_ADDEND:
+            if ADDEND_IS_OUT:
+                x = x + y_reg
+            else:
+                x = x + tl.load(Addend + row_off + offs, mask, other=0).to(tl.float32)
+    return x
+
+
+@triton.jit
+def _sconv_mix_kernel(
+    x_ptr, cache_ptr, weight_ptr, out_ptr, res_ptr, addend_ptr,
+    pos_ptr, seq_idx_ptr, slot_ptr, block_table_ptr, qstart_ptr,
+    T, stride_x, stride_c_blk, stride_c_h, stride_c_n, stride_w0, stride_w1,
+    stride_bt, max_blocks, N, scale,
+    Stack, MLast, MAddend, Queries, NormW, MixOut, stride_s, eps, norm_eps,
+    W: tl.constexpr, OFF: tl.constexpr, WS: tl.constexpr, H: tl.constexpr,
+    HAS_RES: tl.constexpr, HAS_ADDEND: tl.constexpr,
+    D: tl.constexpr, NUM_Q: tl.constexpr, N_STACK: tl.constexpr,
+    M_HAS_ADDEND: tl.constexpr, NORMALIZE: tl.constexpr, BLOCK_N: tl.constexpr,
+    BLOCK_A: tl.constexpr, BLOCK_B: tl.constexpr, APPLY_NORM: tl.constexpr,
+    LAST_IS_OUT: tl.constexpr, ADDEND_IS_OUT: tl.constexpr,
+):
+    t = tl.program_id(0)
+    da = tl.arange(0, BLOCK_A)
+    db = BLOCK_A + tl.arange(0, BLOCK_B)
+    mask_a = da < D
+    mask_b = db < D
+    cargs = (x_ptr, cache_ptr, weight_ptr, out_ptr, res_ptr, addend_ptr, pos_ptr,
+             seq_idx_ptr, slot_ptr, block_table_ptr, qstart_ptr, T, stride_x, stride_c_blk,
+             stride_c_h, stride_c_n, stride_w0, stride_w1, stride_bt, max_blocks, N, scale, t)
+    # The conv output stays in registers for the mix (no cross-warp reload).
+    ya = tl.reshape(_conv_chunk(*cargs, da, W, OFF, WS, H, HAS_RES, HAS_ADDEND),
+                    (BLOCK_A,)).to(tl.float32)
+    yb = tl.reshape(_conv_chunk(*cargs, db, W, OFF, WS, H, HAS_RES, HAS_ADDEND),
+                    (BLOCK_B,)).to(tl.float32)
+    ya = tl.where(mask_a, ya, 0.0)
+    yb = tl.where(mask_b, yb, 0.0)
+    row_off = t.to(tl.int64) * D
+    n_idx = tl.arange(0, BLOCK_N)
+    for qi in tl.static_range(NUM_Q):
+        q_off = qi * D
+        qa = tl.load(Queries + q_off + da, mask_a, other=0)
+        qb = tl.load(Queries + q_off + db, mask_b, other=0)
+        logits = tl.full((BLOCK_N,), float("-inf"), tl.float32)
+        inv_rms = tl.zeros((BLOCK_N,), tl.float32)
+        for n in tl.static_range(N_STACK + 1):
+            xa = _src(Stack, stride_s, MLast, MAddend, row_off, da, mask_a, n, N_STACK,
+                      M_HAS_ADDEND, LAST_IS_OUT, ADDEND_IS_OUT, ya)
+            xb = _src(Stack, stride_s, MLast, MAddend, row_off, db, mask_b, n, N_STACK,
+                      M_HAS_ADDEND, LAST_IS_OUT, ADDEND_IS_OUT, yb)
+            rstd = tl.rsqrt(tl.fma(tl.sum(xa * xa) + tl.sum(xb * xb), 1.0 / D, eps))
+            inv_rms = tl.where(n_idx == n, rstd, inv_rms)
+            dot = tl.sum(qa * xa) + tl.sum(qb * xb)
+            logits = tl.where(n_idx == n, dot * rstd, logits)
+        probs = tldevice.exp(logits - tl.max(logits))
+        inv_sum = tl.div_rn(1.0, tl.sum(probs))
+        if NORMALIZE:
+            probs = probs * inv_rms
+        acc_a = tl.zeros((BLOCK_A,), tl.float32)
+        acc_b = tl.zeros((BLOCK_B,), tl.float32)
+        for n in tl.static_range(N_STACK + 1):
+            p = tl.sum(tl.where(n_idx == n, probs, 0.0))
+            xa = _src(Stack, stride_s, MLast, MAddend, row_off, da, mask_a, n, N_STACK,
+                      M_HAS_ADDEND, LAST_IS_OUT, ADDEND_IS_OUT, ya)
+            xb = _src(Stack, stride_s, MLast, MAddend, row_off, db, mask_b, n, N_STACK,
+                      M_HAS_ADDEND, LAST_IS_OUT, ADDEND_IS_OUT, yb)
+            acc_a = tl.fma(p, xa, acc_a)
+            acc_b = tl.fma(p, xb, acc_b)
+        acc_a = acc_a * inv_sum
+        acc_b = acc_b * inv_sum
+        mo = MixOut + qi * T * D + row_off
+        if APPLY_NORM:
+            sum_sq = tl.sum(acc_a * acc_a) + tl.sum(acc_b * acc_b)
+            out_rstd = tl.rsqrt(tl.div_rn(sum_sq, D) + norm_eps)
+            wa = tl.load(NormW + q_off + da, mask_a, other=0).to(tl.float32)
+            wb = tl.load(NormW + q_off + db, mask_b, other=0).to(tl.float32)
+            acc_a = acc_a * out_rstd * wa
+            acc_b = acc_b * out_rstd * wb
+        tl.store(mo + da, acc_a.to(MixOut.dtype.element_ty), mask_a)
+        tl.store(mo + db, acc_b.to(MixOut.dtype.element_ty), mask_b)
+
+
+def _same(a, b) -> bool:
+    return a is not None and a.data_ptr() == b.data_ptr() and a.shape == b.shape
+
+
+def short_conv_mix(
+    x, weight, cache, positions, block_table, seq_idx, slot_mapping, query_start,
+    stream_offset, stream_width, addend, residual, out,
+    stack, last, mix_addend, queries, norm_weight, norm_eps, normalize_values,
+    eps: float = 1e-6,
+):
+    """`short_conv(...)` then `attn_res(stack, last, mix_addend, queries,
+    norm_weight, ...)` in one launch (T <= MAX_T); `last` / `mix_addend` may
+    be `out`. Returns the mixes `(Q, T, D)`."""
+    num_tokens, channels = x.shape
+    num_heads = cache.shape[1]
+    width = weight.shape[1]
+    num_q, d = queries.shape
+    assert channels == num_heads * stream_width == d and width == 4
+    assert x.stride(1) == 1 and cache.stride(3) == 1 and out.is_contiguous()
+    assert last.is_contiguous() and queries.dtype == torch.float32
+    assert stack.stride(1) == d and stack.stride(2) == 1
+    apply_norm = norm_weight is not None
+    mix = torch.empty((num_q, num_tokens, d), dtype=last.dtype if apply_norm else torch.float32,
+                      device=x.device)
+    if num_tokens == 0:
+        return mix
+    block_a = triton.next_power_of_2(d + 1) // 2
+    block_b = max(triton.next_power_of_2(d - block_a), 16)
+    _sconv_mix_kernel[(num_tokens,)](
+        x, cache, weight, out, residual, addend,
