+@triton.jit
+def _gemv_kernel(
+    X0, X1, X2, W, Y, M, N, K, N1, N2, stride_xm, stride_ym,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, EVEN_N: tl.constexpr,
+    WA=None, YA=None, NA=0, WB=None, YB=None, NB=0, stride_ya=0, stride_yb=0,
+    EXTRA: tl.constexpr = False,
+):
+    # EXTRA: programs past W's row blocks run two more small weights, WA
+    # against X1 and WB against X2, into their own outputs (the K/V dynamic
+    # tap projections fused into the qkvr launch). The main row blocks keep
+    # the unmasked weight loads.
+    pid = tl.program_id(0)
+    nb_main = tl.cdiv(N, BN)
+    if EXTRA and pid >= nb_main:
+        nb_a = tl.cdiv(NA, BN)
+        if pid - nb_main < nb_a:
+            _gemv_tile(X1, WA, YA, (pid - nb_main) * BN, M, NA, K, stride_xm, stride_ya,
+                       BM, BN, BK, True)
+        else:
+            _gemv_tile(X2, WB, YB, (pid - nb_main - nb_a) * BN, M, NB, K, stride_xm,
+                       stride_yb, BM, BN, BK, True)
+    else:
+        n0 = pid * BN
+        # Row blocks never straddle n1 / n2 (BN divides both).
+        if n0 < N1:
+            X = X0
+        elif n0 < N2:
+            X = X1
+        else:
+            X = X2
+        _gemv_tile(X, W, Y, n0, M, N, K, stride_xm, stride_ym, BM, BN, BK, not EVEN_N)
+
+
 def _cfg(M: int, K: int) -> tuple[int, int, int, int]:
     """(BM, BN, BK, num_warps) from uncached sweeps on gfx1201."""
     bm = triton.next_power_of_2(max(M, 1))
@@ -92,6 +115,29 @@ def gemv3(x0, x1, x2, w, n1: int, n2: int, cfg=None) -> torch.Tensor:
     return out
 
 
+def gemv3x(x0, x1, x2, w, n1: int, n2: int, wa, wb, cfg=None):
+    """`gemv3` plus `x1 @ wa.T` and `x2 @ wb.T` in the same launch. Returns
+    (out, ya, yb)."""
+    M, K = x0.shape
+    N = w.shape[0]
+    assert w.shape[1] == K and w.stride(1) == 1
+    assert wa.shape[1] == K and wb.shape[1] == K and wa.stride(1) == wb.stride(1) == 1
+    assert wa.dtype == wb.dtype == w.dtype == torch.bfloat16
+    assert x1.stride() == x0.stride() and x2.stride() == x0.stride()
+    out = torch.empty((M, N), dtype=torch.bfloat16, device=x0.device)
+    ya = torch.empty((M, wa.shape[0]), dtype=torch.bfloat16, device=x0.device)
+    yb = torch.empty((M, wb.shape[0]), dtype=torch.bfloat16, device=x0.device)
+    bm, bn, bk, nw = cfg or _cfg(M, K)
+    assert n1 % bn == 0 and n2 % bn == 0
+    grid = (triton.cdiv(N, bn) + triton.cdiv(wa.shape[0], bn) + triton.cdiv(wb.shape[0], bn),)
+    _gemv_kernel[grid](
+        x0, x1, x2, w, out, M, N, K, n1, n2, x0.stride(0), out.stride(0),
+        BM=bm, BN=bn, BK=bk, EVEN_N=N % bn == 0,
+        WA=wa, YA=ya, NA=wa.shape[0], WB=wb, YB=yb, NB=wb.shape[0],
+        stride_ya=ya.stride(0), stride_yb=yb.stride(0), EXTRA=True, num_warps=nw)
+    return out, ya, yb
+
+
 def gemv(x: torch.Tensor, w: torch.Tensor, cfg=None) -> torch.Tensor:
     N = w.shape[0]
     return gemv3(x, x, x, w, N, N, cfg)
