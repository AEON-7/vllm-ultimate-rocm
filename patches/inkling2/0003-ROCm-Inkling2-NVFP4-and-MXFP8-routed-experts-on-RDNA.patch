+++ b/vllm/models/inkling2/amd/moe_gfx12.py
@@ -0,0 +1,176 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 AEON-7
+# Original AEON work (clean room, written from AEON SPEC.md section 3). The
+# parameter names and checkpoint layout follow upstream vLLM
+# `vllm/models/inkling2/nvidia/moe.py` (PR #69028, Apache-2.0).
+"""Inkling2 mixture-of-experts layer for RDNA4 (gfx12): NVFP4 or MXFP8
+routed experts served from the checkpoint's packed weights, BF16
+activations, in-register weight decode (`ops.moe_dequant`).
+
+Routing follows the reference: fp32 router logits, sigmoid scores, top-k of
+`scores + bias`, weights normalized over the picks and scaled by
+`route_scale`. TP shards the experts contiguously (EP = TP) and all-reduces
+the bf16 output.
+"""
+
+from typing import Literal
+
+import torch
+from torch import nn
+
+from vllm.distributed import (
+    get_tensor_model_parallel_rank,
+    get_tensor_model_parallel_world_size,
+    tensor_model_parallel_all_reduce,
+)
+from vllm.model_executor.model_loader.weight_utils import default_weight_loader
+from vllm.model_executor.utils import set_weight_attrs
+
+from .ops.moe_dequant import expert_mlp
+
+QuantFormat = Literal["nvfp4", "mxfp8"]
+
+
+class Inkling2Gfx12Gate(nn.Module):
+    def __init__(self, config) -> None:
+        super().__init__()
+        assert config.use_gate_bias
+        num_experts, hidden = config.n_routed_experts, config.hidden_size
+        self.topk = config.num_experts_per_tok
+        self.route_scale = config.route_scale
+        self.weight = nn.Parameter(
+            torch.empty(num_experts, hidden, dtype=torch.bfloat16),
+            requires_grad=False,
+        )
+        self.bias = nn.Parameter(
+            torch.empty(num_experts, dtype=torch.float32), requires_grad=False
+        )
+        for param in (self.weight, self.bias):
+            set_weight_attrs(param, {"weight_loader": default_weight_loader})
+        self.register_buffer("weight_f32", torch.empty(0), persistent=False)
+
+    def process_weights_after_loading(self) -> None:
+        self.weight_f32 = self.weight.data.float()
+
+    def forward(self, x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """Top-k expert ids (int64) and fp32 routing weights of bf16 `x`."""
+        weight = self.weight_f32 if self.weight_f32.numel() else self.weight.float()
+        logits = torch.mm(x.float(), weight.t())
+        scores = torch.sigmoid(logits)
+        ids = torch.topk(scores + self.bias, self.topk, dim=-1, sorted=False).indices
+        weights = scores.gather(1, ids)
+        weights = weights / (weights.sum(dim=-1, keepdim=True) + 1e-20)
+        return ids, weights * self.route_scale
+
+
+class Inkling2Gfx12Experts(nn.Module):
+    def __init__(self, config, quant_format: QuantFormat) -> None:
+        super().__init__()
+        self.ep_rank = get_tensor_model_parallel_rank()
+        self.ep_size = get_tensor_model_parallel_world_size()
+        assert config.n_routed_experts % self.ep_size == 0
+        self.num_experts = config.n_routed_experts // self.ep_size
+        self.topk = config.num_experts_per_tok
+        self.gate_cap = float(config.mlp_gate_softcap)
+        self.up_cap = float(config.mlp_up_softcap)
+        self.nvfp4 = quant_format == "nvfp4"
+        hidden, inter = config.hidden_size, config.intermediate_size
+        pack, group = (2, 16) if self.nvfp4 else (1, 32)
+        weight_dtype = torch.uint8 if self.nvfp4 else torch.float8_e4m3fn
+        scale_dtype = torch.float8_e4m3fn if self.nvfp4 else torch.uint8
+        for name, (n, k) in (("w13", (2 * inter, hidden)), ("w2", (hidden, inter))):
+            self._register(f"{name}_weight", (n, k // pack), weight_dtype)
+            self._register(f"{name}_weight_scale", (n, k // group), scale_dtype)
+            if self.nvfp4:
+                self._register(f"{name}_weight_amax", (), torch.float32)
+                self._register(
+                    f"{name}_weight_outer_scale_denominator",
+                    (1,),
+                    torch.float32,
+                    per_expert=False,
+                )
+        self.global_scales: dict[str, torch.Tensor] = {}
+
+    def _register(
+        self,
+        name: str,
+        shape: tuple[int, ...],
+        dtype: torch.dtype,
+        per_expert: bool = True,
+    ) -> None:
+        if per_expert:
+            shape = (self.num_experts, *shape)
+        param = nn.Parameter(torch.empty(shape, dtype=dtype), requires_grad=False)
+        loader = self._load_expert_shard if per_expert else self._load_full
+        set_weight_attrs(param, {"weight_loader": loader})
+        self.register_parameter(name, param)
+
+    def _load_expert_shard(self, param: nn.Parameter, loaded: torch.Tensor) -> None:
+        start = self.ep_rank * self.num_experts
+        self._load_full(param, loaded[start : start + self.num_experts])
+
+    @staticmethod
+    def _load_full(param: nn.Parameter, loaded: torch.Tensor) -> None:
+        assert loaded.shape == param.shape and loaded.dtype == param.dtype, (
+            f"{loaded.shape} {loaded.dtype} != {param.shape} {param.dtype}"
+        )
+        param.data.copy_(loaded)
+
+    def process_weights_after_loading(self) -> None:
+        # The checkpoint interleaves the gate and up rows of w13 (row 2i is
+        # gate i, row 2i + 1 is up i); the kernel reads [gate; up] halves.
+        # De-interleave the weight and its block scales once, in place.
+        for name in ("w13_weight", "w13_weight_scale"):
+            param = getattr(self, name)
+            e, n, k = param.shape
+            halves = param.data.view(e, n // 2, 2, k).transpose(1, 2).contiguous()
+            param.data.copy_(halves.view(e, n, k))
+            del halves
+        if self.nvfp4:
+            for name in ("w13", "w2"):
+                amax = getattr(self, f"{name}_weight_amax").data.float()
+                denom = getattr(self, f"{name}_weight_outer_scale_denominator").data
+                self.global_scales[name] = (amax / denom.float()).contiguous()
+
+    def _operands(self, name: str):
+        weight = getattr(self, f"{name}_weight").data
+        scale = getattr(self, f"{name}_weight_scale").data
+        return (
+            weight.view(torch.uint8),
+            scale.view(torch.uint8),
+            self.global_scales.get(name),
+        )
+
+    def forward(
+        self, x: torch.Tensor, ids: torch.Tensor, weights: torch.Tensor
+    ) -> torch.Tensor:
+        if self.ep_size > 1:
+            start = self.ep_rank * self.num_experts
+            local = (ids >= start) & (ids < start + self.num_experts)
+            weights = torch.where(local, weights, torch.zeros_like(weights))
+            ids = torch.where(local, ids - start, torch.zeros_like(ids))
+        out = expert_mlp(
+            x,
+            ids,
+            weights,
+            self._operands("w13"),
+            self._operands("w2"),
+            0 if self.nvfp4 else 1,
+            self.gate_cap,
+            self.up_cap,
+        )
+        return out if self.ep_size == 1 else tensor_model_parallel_all_reduce(out)
+
+
+class Inkling2Gfx12MoE(nn.Module):
+    def __init__(self, config, quant_format: QuantFormat) -> None:
+        super().__init__()
+        assert config.n_shared_experts == 0
+        self.gate = Inkling2Gfx12Gate(config)
+        self.experts = Inkling2Gfx12Experts(config, quant_format)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        """bf16 [T, H] -> bf16 [T, H]."""
+        x = x.contiguous()
+        ids, weights = self.gate(x)
+        return self.experts(x, ids, weights)
