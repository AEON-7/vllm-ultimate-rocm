+# SPDX-License-Identifier: Apache-2.0
+# Copyright 2026 AEON-7
+# Original AEON work.
+"""HTTP API for AEON per-request ablation variants (only mounted when
+AEON_VARIANT_DIR is set).
+
+GET    /aeon/variants          list registered variants
+POST   /aeon/variants          register or replace one:
+       {"name": "v1", "dirs": [...], "scales": [...]}  (see aeon_variants)
+       or {"name": "v1", "path": "/server/side/file.safetensors"}
+DELETE /aeon/variants/{name}   remove one
+Requests then pick a variant with "aeon_variant": "v1" (or "stock").
+"""
+
+from typing import Any
+
+from fastapi import APIRouter, FastAPI, HTTPException
+from pydantic import BaseModel
+
+from vllm.models.inkling2.amd import aeon_variants as av
+
+router = APIRouter()
+
+
+class RegisterVariantRequest(BaseModel):
+    name: str
+    dirs: Any = None
+    scales: Any = None
+    path: str | None = None
+    replace: bool = True
+
+
+@router.get("/aeon/variants")
+async def get_variants() -> dict:
+    return {"variants": av.list_variants()}
+
+
+@router.post("/aeon/variants")
+async def register_variant(req: RegisterVariantRequest) -> dict:
+    import torch
+
+    try:
+        name = av.normalize_name(req.name)
+        if name is None:
+            raise ValueError("'stock' is reserved for the unedited model")
+        if not req.replace and __import__("os").path.exists(av.variant_path(name)):
+            raise ValueError(f"variant {name!r} exists and replace=false")
+        if req.path:
+            dirs, scales = av.read_variant(req.path)
+        elif req.dirs is not None and req.scales is not None:
+            dirs = torch.tensor(req.dirs, dtype=torch.float32)
+            scales = torch.tensor(req.scales, dtype=torch.float32)
+        else:
+            raise ValueError("give either path or dirs and scales")
+        return av.save_variant(name, dirs, scales)
+    except (ValueError, KeyError, RuntimeError, FileNotFoundError) as e:
+        raise HTTPException(status_code=400, detail=str(e)) from e
+
+
+@router.delete("/aeon/variants/{name}")
+async def remove_variant(name: str) -> dict:
+    try:
+        ok = av.delete_variant(name)
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e)) from e
+    if not ok:
+        raise HTTPException(status_code=404, detail=f"no variant {name!r}")
+    return {"deleted": name}
+
+
+def attach_router(app: FastAPI) -> None:
+    if av.variant_dir():
+        app.include_router(router)
