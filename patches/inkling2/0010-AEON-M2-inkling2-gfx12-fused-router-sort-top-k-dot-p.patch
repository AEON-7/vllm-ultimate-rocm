+@triton.jit
+def _topk_row(Logits, Bias, Ids, Wts, Count, Bucket, Active, NActive, t,
+              E: tl.constexpr, TOPK: tl.constexpr, SCALE: tl.constexpr, MAXR: tl.constexpr):
+    """Top-k of score + bias for token t without a serial loop: each
+    expert's rank is the number of experts ahead of it (higher value, or
+    equal value and lower index, the order of a serial argmax)."""
+    e_idx = tl.arange(0, E)
+    acc = tl.load(Logits + t * E + e_idx, volatile=True)
+    score = 1.0 / (1.0 + tl.exp(-acc))
+    sel = score + tl.load(Bias + e_idx)
+    sel_j = tl.load(Logits + t * E + e_idx, volatile=True)
+    sel_j = 1.0 / (1.0 + tl.exp(-sel_j)) + tl.load(Bias + e_idx)
+    ahead = (sel_j[None, :] > sel[:, None]) | ((sel_j[None, :] == sel[:, None]) & (e_idx[None, :] < e_idx[:, None]))
+    rank = tl.sum(ahead.to(tl.int32), axis=1)                       # [E]
+    k_idx = tl.arange(0, TOPK)
+    hit = rank[None, :] == k_idx[:, None]                            # [TOPK, E]
+    ids = tl.sum(tl.where(hit, e_idx[None, :], 0), axis=1)
+    wts = tl.sum(tl.where(hit, score[None, :], 0.0), axis=1)
+    slot = tl.atomic_add(Count + ids, 1)
+    tl.store(Bucket + ids * MAXR + slot, t * TOPK + k_idx)
+    first = slot == 0
+    a = tl.atomic_add(NActive + k_idx * 0, 1, mask=first)
+    tl.store(Active + a, ids, mask=first)
+    wts = wts / (tl.sum(wts, axis=0) + 1e-20) * SCALE
+    tl.store(Ids + t * TOPK + k_idx, ids)
+    tl.store(Wts + t * TOPK + k_idx, wts)
 
 
