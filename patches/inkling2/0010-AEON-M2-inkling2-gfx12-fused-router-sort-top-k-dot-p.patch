+@triton.jit
+def _topk_all(Logits, Bias, Ids, Wts, Count, Bucket, Active, NActive, T,
+              E: tl.constexpr, TOPK: tl.constexpr, SCALE: tl.constexpr, MAXR: tl.constexpr,
+              BT: tl.constexpr):
+    """Top-k of score + bias for all T tokens at once with one bitonic sort.
+    Key = order-preserving int of the fp32 selection value in the high word,
+    (E - 1 - expert) in the low word, so a descending sort gives the order of
+    a serial argmax (higher value first, lower index on ties)."""
+    t_idx = tl.arange(0, BT)
+    tm = t_idx < T
+    e_idx = tl.arange(0, E)
+    lg = tl.load(Logits + t_idx[:, None] * E + e_idx[None, :], mask=tm[:, None], other=0.0,
+                 volatile=True)
+    score = 1.0 / (1.0 + tl.exp(-lg))
+    sel = score + tl.load(Bias + e_idx)[None, :]
+    b = sel.to(tl.int32, bitcast=True)
+    key = tl.where(b >= 0, b, b ^ 0x7FFFFFFF).to(tl.int64)
+    key = (key << 32) | (E - 1 - e_idx[None, :]).to(tl.int64)
+    srt = tl.sort(key, 1, descending=True)
+    k_idx = tl.arange(0, TOPK)
+    top = tl.sum(tl.where(e_idx[None, None, :] == k_idx[None, :, None], srt[:, None, :], 0), axis=2)
+    ids = (E - 1 - (top & 0xFFFFFFFF)).to(tl.int32)                  # [BT, TOPK]
+    wts = tl.sum(tl.where(e_idx[None, None, :] == ids[:, :, None], score[:, None, :], 0.0), axis=2)
+    m2 = tm[:, None] & (k_idx[None, :] >= 0)
+    slot = tl.atomic_add(Count + ids, 1, mask=m2)
+    rr = t_idx[:, None] * TOPK + k_idx[None, :]
+    tl.store(Bucket + ids * MAXR + slot, rr, mask=m2)
+    first = m2 & (slot == 0)
+    a = tl.atomic_add(NActive + ids * 0, 1, mask=first)
+    tl.store(Active + a, ids, mask=first)
+    wts = wts / (tl.sum(wts, axis=1)[:, None] + 1e-20) * SCALE
+    tl.store(Ids + rr, ids, mask=m2)
+    tl.store(Wts + rr, wts, mask=m2)
+
