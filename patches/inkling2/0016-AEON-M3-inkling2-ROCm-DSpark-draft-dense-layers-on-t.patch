From 21add0ba8db5abe40a90ef20709f6a0a95ed31e6 Mon Sep 17 00:00:00 2001
From: AEON-7 <aeon-7@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:22:56 -0600
Subject: [PATCH 16/16] [AEON M3] inkling2 ROCm: DSpark draft dense layers on
 the AEON small-M GEMV (<= 8 rows)

hipBLASLt small-M tiles read the 3-layer bf16 draft at about half bandwidth for one 8-token block. Using the AEON GEMV saves about 2.2 ms per spec step at bs1 (math prompt: 33.9 -> 31.7 ms/step). AEON_DSPARK_GEMV=0 restores the torch path. Original AEON work (clean room), Apache-2.0.
---
 vllm/models/inkling2/amd/dspark.py | 24 +++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/vllm/models/inkling2/amd/dspark.py b/vllm/models/inkling2/amd/dspark.py
index ee3232dfc..52253de8e 100644
--- a/vllm/models/inkling2/amd/dspark.py
+++ b/vllm/models/inkling2/amd/dspark.py
@@ -48,6 +48,20 @@ from .ops.dspark import (
     silu_and_mul,
 )
 from .ops.norm import fused_add_rms_norm, rms_norm
+from .ops import gemv as _gemv
+import os as _os
+
+# AEON M3: the draft runs one 8-token block per request, where hipBLASLt's
+# small-M tiles read the dense draft weights at about half bandwidth; use the
+# AEON small-M GEMV up to 8 rows (draft numerics only affect acceptance).
+_DRAFT_GEMV = _os.environ.get("AEON_DSPARK_GEMV", "1") == "1"
+
+
+def _linear(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    if (_DRAFT_GEMV and _gemv.eligible(x, 8) and w.dtype == torch.bfloat16
+            and w.stride(1) == 1):
+        return _gemv.gemv(x, w)
+    return nn.functional.linear(x, w)
 
 
 class _RMSNorm(nn.Module):
@@ -160,7 +174,7 @@ class Inkling2DraftSelfAttention(nn.Module):
     def forward(
         self, positions: torch.Tensor, x: torch.Tensor, cos_sin_cache: torch.Tensor
     ) -> torch.Tensor:
-        qkv = nn.functional.linear(x, self.qkv_proj.weight)
+        qkv = _linear(x, self.qkv_proj.weight)
         qk_norm_rope_(
             qkv,
             positions,
@@ -210,7 +224,7 @@ class Inkling2DraftSelfAttention(nn.Module):
                 window=self.window,
                 num_splits=num_splits,
             )
-        return nn.functional.linear(out, self.o_proj.weight)
+        return _linear(out, self.o_proj.weight)
 
     def store_context_kv(
         self,
@@ -219,7 +233,7 @@ class Inkling2DraftSelfAttention(nn.Module):
         cos_sin_cache: torch.Tensor,
         slot_mapping: torch.Tensor | None,
     ) -> None:
-        k, v = nn.functional.linear(context, self.kv_proj_ctx.weight).split(
+        k, v = _linear(context, self.kv_proj_ctx.weight).split(
             [self.kv_size, self.kv_size], -1
         )
         k = self.k_norm_ctx(k.reshape(-1, self.head_dim))
@@ -248,8 +262,8 @@ class Inkling2DraftMLP(nn.Module):
         )
 
     def forward(self, x: torch.Tensor) -> torch.Tensor:
-        x = silu_and_mul(nn.functional.linear(x, self.gate_up_proj.weight))
-        return nn.functional.linear(x, self.down_proj.weight)
+        x = silu_and_mul(_linear(x, self.gate_up_proj.weight))
+        return _linear(x, self.down_proj.weight)
 
 
 class Inkling2DraftLayer(nn.Module):
